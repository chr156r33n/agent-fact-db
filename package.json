{
  "name": "agent-fact-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler d1 migrations apply agent-fact-db --local && wrangler dev",
    "test": "node scripts/test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply agent-fact-db --remote",
    "deploy": "node scripts/configure.mjs --required && npm run db:migrate && wrangler deploy",
    "configure": "node scripts/configure.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

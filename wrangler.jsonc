{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-fact-db",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-fact-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
